<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_list"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Popis svih jela"
        android:textColor="@color/plava"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Kliknite na jelo za detalje, uređivanje i brisanje"
        android:textColor="@color/tekst_sivi"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPraznoPopis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Još nema unesenih jela."
        android:textAlignment="center"
        android:textColor="@color/tekst_sivi"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvJela"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/pozadina"
        android:dividerHeight="8dp" />

</LinearLayout>
