<?xml version="1.0" encoding="utf-8"?>
<!-- Jedan redak u popisu jela: slicica, naziv i kalorije. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/ivSlikaStavke"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Slika jela"
            android:scaleType="centerCrop" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNazivStavke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Naziv jela"
            android:textColor="@color/tekst_tamni"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvKalorijeStavke"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 kcal"
            android:textColor="@color/tekst_sivi"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
