<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadina"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_diary"
        android:drawablePadding="10dp"
        android:gravity="center_vertical"
        android:text="Dnevnik obroka"
        android:textColor="@color/tirkizna"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Kliknite na unos za uređivanje ili brisanje"
        android:textColor="@color/tekst_sivi"
        android:textSize="13sp" />

    <!-- odabir razdoblja -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOdDatum"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@color/tirkizna"
            android:text="Od: -"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDoDatum"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@color/tirkizna"
            android:text="Do: -"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/tirkizna_svijetla"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <TextView
            android:id="@+id/tvZbrojRazdoblja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:text="Ukupno: 0 kcal"
            android:textColor="@color/tirkizna"
            android:textSize="15sp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvPraznoDnevnik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:text="Nema unosa u odabranom razdoblju."
        android:textAlignment="center"
        android:textColor="@color/tekst_sivi"
        android:textSize="14sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvUnosi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/pozadina"
        android:dividerHeight="8dp" />

</LinearLayout>
