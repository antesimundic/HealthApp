<?xml version="1.0" encoding="utf-8"?>
<!-- Jedan redak u dnevniku: vrijeme, naziv jela, kolicina i kalorije. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvVrijemeStavke"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/tirkizna_svijetla"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="12:00"
        android:textColor="@color/tirkizna"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNazivUnosa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Naziv jela"
            android:textColor="@color/tekst_tamni"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetaljiUnosa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2026-01-01  •  1 porcija"
            android:textColor="@color/tekst_sivi"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvKalorijeUnosa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="0 kcal"
        android:textColor="@color/zelena"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
